# ------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Database ---
# Recommended local dev: `docker compose up -d` then use the URL below
# (compose maps Postgres to host port 5433 to avoid clashing with any
# native Postgres on 5432).
DATABASE_URL="postgresql://pankajpramanik:pankajpramanik_dev@localhost:5433/pankajpramanik?schema=public"
# Native install alternative: postgresql://<user>@localhost:5432/pankajpramanik
# Production (in the docker network): postgresql://appuser:PASS@db:5432/pankajpramanik

# --- Redis (optional; used for cross-instance contact-form rate limiting) ---
# compose maps Redis to host port 6380. Leave unset to use in-memory limiting.
REDIS_URL="redis://localhost:6380"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical URL of the app (needed behind the Nginx proxy in production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Initial admin user (consumed by `npm run db:seed`) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Pankaj Kumar Pramanik"
# Plain password used ONLY by the seed script to create the first admin
# (it is hashed with bcrypt before storage). Set it before seeding; reseeding does not change an existing password.
ADMIN_PASSWORD=""

# --- Resend (contact form email) ---
# Create an API key at https://resend.com — free tier is fine to start.
RESEND_API_KEY=""
# Where contact form submissions are delivered
CONTACT_EMAIL="pkp2.me2k9@gmail.com"
# Verified sender. Until you verify your domain in Resend you can use
# onboarding@resend.dev for testing.
CONTACT_FROM_EMAIL="Portfolio Contact <pkp2.me2k9@gmail.com>"

# --- Media storage ---
# Uploads are saved to $STORAGE_DIR/uploads/YYYY/MM/DD and served at /uploads/*.
# Defaults to ./storage in the project root; production mounts /app/storage.
# STORAGE_DIR="./storage"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Booking system (/booking, /admin/booking) ---
# Sender for booking emails (defaults to CONTACT_FROM_EMAIL). Same Resend key.
BOOKING_FROM_EMAIL=""
# Encrypts stored Google OAuth tokens (defaults to AUTH_SECRET). openssl rand -base64 32
BOOKING_ENCRYPTION_KEY=""
# Bearer token for GET /api/cron/booking-reminders (run every 5 minutes).
CRON_SECRET=""
# Google Calendar (optional). OAuth "Web application" client; redirect URI:
#   http://localhost:3000/api/admin/booking/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Outreach agent (/admin/outreach) ---
# Design record: docs/outreach-agent-architecture.md
# The agent runs in a separate worker; the app only reads and writes its state.
OPENAI_API_KEY=""
# Exact model ids — no defaults, so a typo fails loudly instead of billing the wrong model.
OPENAI_MODEL=""
OPENAI_FAST_MODEL=""
OPENAI_REASONING_MODEL=""
# Web research (company, decision-maker). https://tavily.com
TAVILY_API_KEY=""
# Email discovery + verification. Free tier is 25 finds/month — the run-rate limit.
HUNTER_API_KEY=""
# LangGraph checkpoints live in their OWN schema; Prisma owns `public` and would
# otherwise drop these tables as drift.
LANGGRAPH_CHECKPOINT_URL="postgresql://pankajpramanik:pankajpramanik_dev@localhost:5433/pankajpramanik?schema=langgraph"
# Envelope sender for approved outreach (domain must be verified in Resend).
OUTREACH_SENDER="me@pankajpramanik.com"
# Global kill switch. Sending is refused server-side unless this is exactly "true".
OUTREACH_ENABLED="false"
