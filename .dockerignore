# Build artifacts & deps (reinstalled/rebuilt in the image)
node_modules
.next
out

# Local env & secrets — never bake into an image
.env
.env.*
!.env.example
!.env.production.example

# Raw WordPress export (large; only migration/extracted is needed for
# next.config redirects + the seed)
migration/wp-export

# Raw service-thumbnail sources — only the optimized .webp outputs are served
public/services-art/source

# VCS / tooling / editor
.git
.github
.gitignore
*.log
npm-debug.log*
.DS_Store
.vscode
.idea

# Docs & CI that don't belong in the runtime image
README.md
deploy
scratchpad
