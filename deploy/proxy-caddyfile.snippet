# =============================================================================
# pankajpramanik.com — site block for the SHARED proxy at /opt/proxy/Caddyfile
#
# This file is not used by any container in this repo. Paste the block below
# into /opt/proxy/Caddyfile on the VPS, in place of the commented-out "SaaS 2"
# placeholder, and add the matching variable to /opt/proxy/.env.
#
# The same two modes described at the top of that file apply here:
#
#   IP mode        PANKAJPRAMANIK_DOMAIN=http://<vps-ip>:8080
#     Only useful for a smoke test. The bare IP already belongs to the other
#     application, so a second site on the same address needs a distinct port,
#     and Caddy will not issue a certificate for a bare IP.
#
#   Domain mode    PANKAJPRAMANIK_DOMAIN=pankajpramanik.com
#     The real deployment. Point the A record (and the www CNAME) at the VPS
#     BEFORE reloading, or ACME issuance fails and the site serves nothing.
#
# Reload after editing:
#   docker compose -f /opt/proxy/docker-compose.yml exec caddy \
#     caddy reload --config /etc/caddy/Caddyfile
# =============================================================================


# --- 1. Add to /opt/proxy/.env ------------------------------------------------
#
# PANKAJPRAMANIK_DOMAIN=pankajpramanik.com
# PANKAJPRAMANIK_WWW=www.pankajpramanik.com


# --- 2. Add to /opt/proxy/Caddyfile -------------------------------------------

# =============================================================================
# pankajpramanik.com
# =============================================================================
#
# The app container joins the shared `proxy` network under the alias
# `pankajpramanik-app` (see docker-compose.prod.yml in that repo). It publishes
# no host port: Caddy is the only thing that can reach it.
#
# Unlike JourneyMesh there is no nginx in front of the app — Next.js serves its
# own static assets, so the long-cache headers live here.
# =============================================================================

{$PANKAJPRAMANIK_DOMAIN} {
	import common

	# Hashed Next.js build output and never-changing artwork.
	@immutable path /_next/static/* /services-art/* /audio/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Generated hero model (scripts/models/generate-brain.mjs) — stable name.
	@models path /models/*
	header @models Cache-Control "public, max-age=604800"

	# Migrated WordPress media — stable, but replaceable.
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=604800"

	reverse_proxy pankajpramanik-app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}
}

# Canonical host redirect. Domain mode only — delete or comment this out while
# PANKAJPRAMANIK_DOMAIN still carries an http:// scheme, since "www." prefixed
# onto a URL is not a valid site address.
{$PANKAJPRAMANIK_WWW} {
	import common
	redir https://{$PANKAJPRAMANIK_DOMAIN}{uri} permanent
}


# --- 3. Notes -----------------------------------------------------------------
#
# X-Frame-Options: DENY comes from the (common) snippet and applies here too.
# It blocks the site being framed anywhere, which is correct for a portfolio.
#
# The app sets its own Cache-Control on HTML responses (Next.js marks dynamic
# pages private, no-store). Do not add a blanket Cache-Control here — it would
# override those and risk serving one visitor's admin page to another.
