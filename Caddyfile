# STANDALONE FALLBACK — not used by docker-compose.prod.yml.
#
# Production runs behind the shared reverse proxy at /opt/proxy on the VPS
# (see deploy/pankajpramanik.caddy), so this stack ships no Caddy of its
# own. Keep this file for a VPS where this app is the ONLY thing running:
# re-add a `caddy` service publishing 80/443 and mount it at
# /etc/caddy/Caddyfile.
#
# DOMAIN and ACME_EMAIL must be passed to that caddy service (they are not in
# .env.production.example, which targets the shared-proxy setup).
{
	email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	# long-cache immutable Next.js build assets
	@static path /_next/static/* /services-art/* /audio/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# migrated media
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=604800"

	# security headers
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}
