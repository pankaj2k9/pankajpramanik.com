generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ContentFormat {
  HTML
  MARKDOWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  posts        Post[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id             String        @id @default(cuid())
  wpId           Int?          @unique // original WordPress post ID
  slug           String        @unique
  title          String
  excerpt        String        @default("")
  content        String        @default("")
  contentFormat  ContentFormat @default(MARKDOWN)
  coverImage     String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  categories     Category[]
  tags           Tag[]
  comments       Comment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String @default("")
  posts       Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  tagline        String        @default("")
  description    String        @default("")
  content        String        @default("") // optional long-form case study
  contentFormat  ContentFormat @default(MARKDOWN)
  problem        String        @default("")
  approach       String        @default("")
  outcome        String        @default("")
  evidenceUrl    String?
  techStack      String[]      @default([])
  repoUrl        String?
  liveUrl        String?
  coverImage     String?
  category       String        @default("General")
  featured       Boolean       @default(false)
  order          Int           @default(0)
  status         ContentStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, featured, order])
}

model Experience {
  id         String    @id @default(cuid())
  role       String
  company    String
  companyUrl String?
  location   String    @default("Remote")
  startDate  DateTime
  endDate    DateTime?
  current    Boolean   @default(false)
  summary    String    @default("")
  techStack  String[]  @default([])
  highlights String[]  @default([])
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([order, startDate])
}

model SkillGroup {
  id       String   @id @default(cuid())
  category String   @unique
  items    String[] @default([])
  order    Int      @default(0)
}

model Education {
  id          String @id @default(cuid())
  degree      String
  institution String
  startYear   Int
  endYear     Int?
  description String @default("")
  order       Int    @default(0)
}

model Certification {
  id     String  @id @default(cuid())
  title  String
  issuer String
  url    String?
  order  Int     @default(0)
}

model Testimonial {
  id          String  @id @default(cuid())
  quote       String
  author      String
  authorTitle String  @default("")
  featured    Boolean @default(false)
  order       Int     @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PageKind {
  GENERIC
  SERVICE
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  kind           PageKind      @default(GENERIC)
  label          String        @default("") // short display name (service cards)
  summary        String        @default("") // one-line card description
  title          String
  content        String        @default("")
  contentFormat  ContentFormat @default(HTML)
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime      @updatedAt

  @@index([kind])
}

// Records which content snapshot (prisma/content/snapshot.json) was last
// imported, so deploys only overwrite content when the snapshot changed.
model ContentSync {
  id        String   @id
  hash      String
  appliedAt DateTime @default(now()) @updatedAt
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

// Reader comments on blog posts. Held for moderation (PENDING) until approved
// in the admin; only APPROVED comments are rendered, and the email is never
// shown publicly. ipHash is a keyed hash for abuse handling, not the raw IP.
model Comment {
  id        String        @id @default(cuid())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  name      String
  email     String
  body      String
  status    CommentStatus @default(PENDING)
  ipHash    String?
  createdAt DateTime      @default(now())

  @@index([postId, status, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Booking system. Every instant is stored in UTC; wall-clock times (weekly
// hours, breaks) are "HH:mm" strings read in BookingSettings.timezone, so
// daylight-saving changes are resolved when slots are generated. None of these
// tables are part of the content snapshot: production owns its own calendar.
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum MeetingLocation {
  GOOGLE_MEET
  ZOOM
  MICROSOFT_TEAMS
  PHONE
  CUSTOM_LINK
}

enum BlockedKind {
  BLOCKED
  VACATION
}

enum BookingSource {
  PUBLIC
  ADMIN
}

enum NotificationKind {
  VISITOR_CONFIRMATION
  ADMIN_NEW_BOOKING
  VISITOR_RESCHEDULED
  VISITOR_CANCELLED
  ADMIN_CANCELLED
  REMINDER
}

model MeetingType {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  description         String          @default("")
  durationMinutes     Int
  bufferBeforeMinutes Int             @default(0)
  bufferAfterMinutes  Int             @default(0)
  locationType        MeetingLocation @default(GOOGLE_MEET)
  // Zoom/Teams/custom link or phone number, depending on locationType.
  locationDetail      String          @default("")
  active              Boolean         @default(true)
  order               Int             @default(0)
  bookings            Booking[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([active, order])
}

// Weekly working hours. Several rows per weekday allow split shifts.
model AvailabilityRule {
  id        String   @id @default(cuid())
  weekday   Int // 0 = Sunday … 6 = Saturday, in the booking timezone
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([weekday, active])
}

// Recurring breaks inside working hours; weekday null = every day.
model AvailabilityBreak {
  id        String @id @default(cuid())
  weekday   Int?
  startTime String
  endTime   String
  label     String @default("")
}

// One-off unavailability: blocked ranges, whole days and vacations.
model BlockedTime {
  id           String      @id @default(cuid())
  startTimeUTC DateTime
  endTimeUTC   DateTime
  kind         BlockedKind @default(BLOCKED)
  reason       String      @default("")
  createdAt    DateTime    @default(now())

  @@index([startTimeUTC, endTimeUTC])
}

// Singleton (id = "default").
model BookingSettings {
  id                  String   @id @default("default")
  timezone            String   @default("America/New_York")
  bookingEnabled      Boolean  @default(true)
  minNoticeMinutes    Int      @default(240)
  maxDaysAhead        Int      @default(60)
  slotIntervalMinutes Int      @default(30)
  maxPerDay           Int      @default(6)
  // Applied on top of each meeting type (the larger value wins).
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  // New public bookings start as PENDING instead of CONFIRMED.
  requireApproval     Boolean  @default(false)
  notifyEmail         String   @default("")
  reminderOffsets     Int[]    @default([1440, 60, 15])
  updatedAt           DateTime @updatedAt
}

model Booking {
  id                  String                @id @default(cuid())
  // Long random secret for public manage links; never the database id.
  bookingToken        String                @unique
  // Short human reference shown to the visitor, e.g. "PKP-7F3K9Q".
  reference           String                @unique
  meetingType         MeetingType           @relation(fields: [meetingTypeId], references: [id], onDelete: Restrict)
  meetingTypeId       String
  fullName            String
  email               String
  phone               String?
  company             String?
  purpose             String
  notes               String?
  startTimeUTC        DateTime
  endTimeUTC          DateTime
  // Snapshots, so later meeting-type edits do not move existing bookings.
  bufferBeforeMinutes Int                   @default(0)
  bufferAfterMinutes  Int                   @default(0)
  locationType        MeetingLocation
  visitorTimezone     String
  status              BookingStatus         @default(CONFIRMED)
  source              BookingSource         @default(PUBLIC)
  meetingUrl          String?
  calendarEventId     String?
  adminNotes          String?
  cancelReason        String?
  cancelledAt         DateTime?
  rescheduledFrom     Booking?              @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledFromId   String?               @unique
  rescheduledTo       Booking?              @relation("BookingReschedule")
  notifications       BookingNotification[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([startTimeUTC, endTimeUTC])
  @@index([status, startTimeUTC])
  @@index([email])
}

// Outbox for booking emails and reminders; a cron endpoint delivers due rows.
model BookingNotification {
  id            String           @id @default(cuid())
  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String
  kind          NotificationKind
  offsetMinutes Int?
  scheduledFor  DateTime
  sentAt        DateTime?
  attempts      Int              @default(0)
  lastError     String?
  createdAt     DateTime         @default(now())

  @@index([sentAt, scheduledFor])
  @@index([bookingId])
}

// OAuth connection to an external calendar (Google today). Tokens are
// AES-256-GCM encrypted at rest and never leave the server.
model CalendarConnection {
  id              String   @id @default(cuid())
  provider        String   @unique // "google"
  accountEmail    String
  calendarId      String   @default("primary")
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  scope           String   @default("")
  checkBusy       Boolean  @default(true)
  createEvents    Boolean  @default(true)
  createMeetLinks Boolean  @default(true)
  lastError       String?
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Remote Data & AI outreach agent.
// Design record: docs/outreach-agent-architecture.md
//
// The agent itself runs in a separate worker process; these tables are the
// control plane and the audit trail it shares with the admin dashboard.
// ---------------------------------------------------------------------------

enum AgentStatus {
  STOPPED
  RUNNING
  PAUSED
  COMPLETED
  ERROR
}

enum ApprovalStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum SendStatus {
  NOT_SENT
  QUEUED
  SENT
  FAILED
}

enum EmailVerification {
  VALID
  RISKY
  UNKNOWN
  INVALID
}

enum ReplyClass {
  POSITIVE
  INTERVIEW_REQUEST
  NEUTRAL
  NOT_NOW
  WRONG_PERSON
  NEGATIVE
  OUT_OF_OFFICE
  UNSUBSCRIBE
  OTHER
}

model OutreachRun {
  id             String        @id @default(cuid())
  status         AgentStatus   @default(STOPPED)
  targetCount    Int           @default(5)
  qualifiedCount Int           @default(0)
  // LangGraph thread id. RESUME replays this thread's latest checkpoint
  // instead of restarting the search.
  threadId       String        @unique
  // Surfaced on the dashboard when status is ERROR.
  lastError      String?
  // Worker liveness. status RUNNING only records what was ASKED for; this
  // records that a worker is actually turning the graph. A stale or null
  // value against a RUNNING status means nobody is doing the work.
  workerSeenAt   DateTime?
  startedAt      DateTime?
  pausedAt       DateTime?
  resumedAt      DateTime?
  stoppedAt      DateTime?
  completedAt    DateTime?
  opportunities  Opportunity[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

model Opportunity {
  id    String      @id @default(cuid())
  run   OutreachRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  companyName    String
  companyUrl     String?
  jobTitle       String
  jobUrl         String
  jobSource      String
  // Kept verbatim — this is the grounding corpus the draft is checked against.
  jobDescription String
  remoteStatus   String

  matchScore     Int
  // Per-dimension scores, so a number on the dashboard can be audited.
  matchBreakdown Json
  matchReason    String

  contactName       String?
  contactTitle      String?
  contactEmail      String?
  emailSource       String?
  emailVerification EmailVerification?
  linkedinUrl       String?

  emailSubject String?
  emailBody    String?
  coverLetter  String?
  // Path under STORAGE_DIR, same convention as uploads.
  cvFilePath   String?
  // Content hash, so approval can assert the file did not change after review.
  cvVersion    String?

  attachCv          Boolean @default(true)
  attachCoverLetter Boolean @default(false)

  approvalStatus ApprovalStatus @default(DRAFT)
  approvedAt     DateTime?
  sendStatus     SendStatus     @default(NOT_SENT)
  sentAt         DateTime?
  messageId      String?
  // Frozen at approval, compared at send, persisted after. An edit after
  // approval invalidates these and sends the draft back for re-approval.
  sentSubject    String?
  sentBody       String?

  replyStatus ReplyClass?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Guards one run against listing the same job twice. Cross-run dedupe is a
  // query (contactEmail / companyName / DoNotContact), not a constraint.
  @@unique([runId, jobUrl])
  @@index([contactEmail])
  @@index([approvalStatus, sendStatus])
  @@index([companyName])
}

// Global suppression list. Checked before drafting AND again before sending.
model DoNotContact {
  id        String   @id @default(cuid())
  email     String   @unique
  domain    String?
  reason    String
  createdAt DateTime @default(now())

  @@index([domain])
}

// Append-only audit of state transitions, rejections and external calls.
model OutreachEvent {
  id            String   @id @default(cuid())
  runId         String?
  opportunityId String?
  kind          String
  payload       Json
  createdAt     DateTime @default(now())

  @@index([runId, createdAt])
  @@index([opportunityId, createdAt])
}
