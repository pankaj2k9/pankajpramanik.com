generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ContentFormat {
  HTML
  MARKDOWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  posts        Post[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id             String        @id @default(cuid())
  wpId           Int?          @unique // original WordPress post ID
  slug           String        @unique
  title          String
  excerpt        String        @default("")
  content        String        @default("")
  contentFormat  ContentFormat @default(MARKDOWN)
  coverImage     String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  categories     Category[]
  tags           Tag[]
  comments       Comment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String @default("")
  posts       Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  tagline        String        @default("")
  description    String        @default("")
  content        String        @default("") // optional long-form case study
  contentFormat  ContentFormat @default(MARKDOWN)
  problem        String        @default("")
  approach       String        @default("")
  outcome        String        @default("")
  evidenceUrl    String?
  techStack      String[]      @default([])
  repoUrl        String?
  liveUrl        String?
  coverImage     String?
  category       String        @default("General")
  featured       Boolean       @default(false)
  order          Int           @default(0)
  status         ContentStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, featured, order])
}

model Experience {
  id         String    @id @default(cuid())
  role       String
  company    String
  companyUrl String?
  location   String    @default("Remote")
  startDate  DateTime
  endDate    DateTime?
  current    Boolean   @default(false)
  summary    String    @default("")
  techStack  String[]  @default([])
  highlights String[]  @default([])
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([order, startDate])
}

model SkillGroup {
  id       String   @id @default(cuid())
  category String   @unique
  items    String[] @default([])
  order    Int      @default(0)
}

model Education {
  id          String @id @default(cuid())
  degree      String
  institution String
  startYear   Int
  endYear     Int?
  description String @default("")
  order       Int    @default(0)
}

model Certification {
  id     String  @id @default(cuid())
  title  String
  issuer String
  url    String?
  order  Int     @default(0)
}

model Testimonial {
  id          String  @id @default(cuid())
  quote       String
  author      String
  authorTitle String  @default("")
  featured    Boolean @default(false)
  order       Int     @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PageKind {
  GENERIC
  SERVICE
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  kind           PageKind      @default(GENERIC)
  label          String        @default("") // short display name (service cards)
  summary        String        @default("") // one-line card description
  title          String
  content        String        @default("")
  contentFormat  ContentFormat @default(HTML)
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime      @updatedAt

  @@index([kind])
}

// Records which content snapshot (prisma/content/snapshot.json) was last
// imported, so deploys only overwrite content when the snapshot changed.
model ContentSync {
  id        String   @id
  hash      String
  appliedAt DateTime @default(now()) @updatedAt
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

// Reader comments on blog posts. Held for moderation (PENDING) until approved
// in the admin; only APPROVED comments are rendered, and the email is never
// shown publicly. ipHash is a keyed hash for abuse handling, not the raw IP.
model Comment {
  id        String        @id @default(cuid())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  name      String
  email     String
  body      String
  status    CommentStatus @default(PENDING)
  ipHash    String?
  createdAt DateTime      @default(now())

  @@index([postId, status, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Booking system. Every instant is stored in UTC; wall-clock times (weekly
// hours, breaks) are "HH:mm" strings read in BookingSettings.timezone, so
// daylight-saving changes are resolved when slots are generated. None of these
// tables are part of the content snapshot: production owns its own calendar.
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum MeetingLocation {
  GOOGLE_MEET
  ZOOM
  MICROSOFT_TEAMS
  PHONE
  CUSTOM_LINK
}

enum BlockedKind {
  BLOCKED
  VACATION
}

enum BookingSource {
  PUBLIC
  ADMIN
}

enum NotificationKind {
  VISITOR_CONFIRMATION
  ADMIN_NEW_BOOKING
  VISITOR_RESCHEDULED
  VISITOR_CANCELLED
  ADMIN_CANCELLED
  REMINDER
}

model MeetingType {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  description         String          @default("")
  durationMinutes     Int
  bufferBeforeMinutes Int             @default(0)
  bufferAfterMinutes  Int             @default(0)
  locationType        MeetingLocation @default(GOOGLE_MEET)
  // Zoom/Teams/custom link or phone number, depending on locationType.
  locationDetail      String          @default("")
  active              Boolean         @default(true)
  order               Int             @default(0)
  bookings            Booking[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([active, order])
}

// Weekly working hours. Several rows per weekday allow split shifts.
model AvailabilityRule {
  id        String   @id @default(cuid())
  weekday   Int // 0 = Sunday … 6 = Saturday, in the booking timezone
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([weekday, active])
}

// Recurring breaks inside working hours; weekday null = every day.
model AvailabilityBreak {
  id        String @id @default(cuid())
  weekday   Int?
  startTime String
  endTime   String
  label     String @default("")
}

// One-off unavailability: blocked ranges, whole days and vacations.
model BlockedTime {
  id           String      @id @default(cuid())
  startTimeUTC DateTime
  endTimeUTC   DateTime
  kind         BlockedKind @default(BLOCKED)
  reason       String      @default("")
  createdAt    DateTime    @default(now())

  @@index([startTimeUTC, endTimeUTC])
}

// Singleton (id = "default").
model BookingSettings {
  id                  String   @id @default("default")
  timezone            String   @default("America/New_York")
  bookingEnabled      Boolean  @default(true)
  minNoticeMinutes    Int      @default(240)
  maxDaysAhead        Int      @default(60)
  slotIntervalMinutes Int      @default(30)
  maxPerDay           Int      @default(6)
  // Applied on top of each meeting type (the larger value wins).
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  // New public bookings start as PENDING instead of CONFIRMED.
  requireApproval     Boolean  @default(false)
  notifyEmail         String   @default("")
  reminderOffsets     Int[]    @default([1440, 60, 15])
  updatedAt           DateTime @updatedAt
}

model Booking {
  id                  String                @id @default(cuid())
  // Long random secret for public manage links; never the database id.
  bookingToken        String                @unique
  // Short human reference shown to the visitor, e.g. "PKP-7F3K9Q".
  reference           String                @unique
  meetingType         MeetingType           @relation(fields: [meetingTypeId], references: [id], onDelete: Restrict)
  meetingTypeId       String
  fullName            String
  email               String
  phone               String?
  company             String?
  purpose             String
  notes               String?
  startTimeUTC        DateTime
  endTimeUTC          DateTime
  // Snapshots, so later meeting-type edits do not move existing bookings.
  bufferBeforeMinutes Int                   @default(0)
  bufferAfterMinutes  Int                   @default(0)
  locationType        MeetingLocation
  visitorTimezone     String
  status              BookingStatus         @default(CONFIRMED)
  source              BookingSource         @default(PUBLIC)
  meetingUrl          String?
  calendarEventId     String?
  adminNotes          String?
  cancelReason        String?
  cancelledAt         DateTime?
  rescheduledFrom     Booking?              @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledFromId   String?               @unique
  rescheduledTo       Booking?              @relation("BookingReschedule")
  notifications       BookingNotification[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([startTimeUTC, endTimeUTC])
  @@index([status, startTimeUTC])
  @@index([email])
}

// Outbox for booking emails and reminders; a cron endpoint delivers due rows.
model BookingNotification {
  id            String           @id @default(cuid())
  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String
  kind          NotificationKind
  offsetMinutes Int?
  scheduledFor  DateTime
  sentAt        DateTime?
  attempts      Int              @default(0)
  lastError     String?
  createdAt     DateTime         @default(now())

  @@index([sentAt, scheduledFor])
  @@index([bookingId])
}

// OAuth connection to an external calendar (Google today). Tokens are
// AES-256-GCM encrypted at rest and never leave the server.
model CalendarConnection {
  id                String   @id @default(cuid())
  provider          String   @unique // "google"
  accountEmail      String
  calendarId        String   @default("primary")
  accessTokenEnc    String
  refreshTokenEnc   String
  expiresAt         DateTime
  scope             String   @default("")
  checkBusy         Boolean  @default(true)
  createEvents      Boolean  @default(true)
  createMeetLinks   Boolean  @default(true)
  // Let Google Calendar email its own invitation/updates to the attendee as
  // well (sendUpdates=all). The site's confirmation email is sent either way.
  sendGoogleInvites Boolean  @default(false)
  lastError         String?
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
