# ------------------------------------------------------------------
# Production env for docker-compose.prod.yml. Copy to `.env` on the
# server (next to docker-compose.prod.yml) and fill in real values.
# NEVER commit the real .env.
# ------------------------------------------------------------------

# --- Container image (built & pushed by .github/workflows/docker.yml) ---
APP_IMAGE=ghcr.io/pankaj2k9/pankajpramanik:latest

# --- Domain / TLS ---
# TLS is handled by the SHARED proxy at /opt/proxy, not by this stack, so the
# domain is configured there (PANKAJPRAMANIK_DOMAIN in /opt/proxy/.env — see
# deploy/proxy-caddyfile.snippet). These two are only read by the standalone
# Caddyfile fallback; harmless to leave set.
DOMAIN=pankajpramanik.com
ACME_EMAIL=pkp2.me2k9@gmail.com

# --- PostgreSQL (compose creates this db/user; app connects over the
#     internal docker network as host "db") ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=pankajpramanik

# --- Auth.js (NextAuth v5) ---
# openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
AUTH_URL=https://pankajpramanik.com
AUTH_TRUST_HOST=true

# --- Initial admin (used only by the one-time `npm run db:seed`) ---
ADMIN_EMAIL=pkp2.me2k9@gmail.com
ADMIN_NAME=Pankaj Kumar Pramanik
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- Resend (contact form email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=pkp2.me2k9@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <contact@pankajpramanik.com>

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://pankajpramanik.com

# --- Cache (provisioned by compose; app runs fine without it today) ---
REDIS_URL=redis://redis:6379
