# ------------------------------------------------------------------
# Production env for docker-compose.prod.yml.
#
# On the VPS: copy to /opt/pankajpramanik/.env (next to
# docker-compose.prod.yml), fill in real values, then `chmod 600 .env`.
# NEVER commit the real .env. Every value below is a placeholder.
#
# Set by docker-compose.prod.yml itself — do NOT add them here:
#   DATABASE_URL  built from POSTGRES_* below, host `db` (private network)
#   REDIS_URL     redis://redis:6379 (private network)
#   NODE_ENV      production
#   STORAGE_DIR   /app/storage (set in the image; bind mount ./storage)
#   HOSTNAME/PORT 0.0.0.0:3000 inside the container (never published)
# ------------------------------------------------------------------

# --- Container image ---
# The deploy workflow exports the exact build (sha-<commit>) and that wins over
# this line. It is only the fallback for a manual `docker compose up -d`, and
# the workflow keeps the server's cached :latest equal to the deployed build.
APP_IMAGE=ghcr.io/pankaj2k9/pankajpramanik:latest

# --- PostgreSQL (compose creates this db/user on first start of the empty
#     volume; changing them later does NOT change the existing database) ---
POSTGRES_USER=appuser
# Interpolated into a connection URL: use URL-safe characters only.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=pankajpramanik

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_URL=https://pankajpramanik.com
# Required behind the shared Caddy proxy.
AUTH_TRUST_HOST=true

# --- Initial admin ---
# Created on container start only if no user with ADMIN_EMAIL exists; an
# existing admin's password is never changed. Minimum 12 characters, otherwise
# the admin is not created. Change it in the admin after first login.
ADMIN_EMAIL=CHANGE_ME_admin_email
ADMIN_NAME=Pankaj Kumar Pramanik
ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# --- Resend (contact form email) ---
RESEND_API_KEY=CHANGE_ME_re_xxxxxxxxxxxxxxxx
# Where contact form submissions are delivered.
CONTACT_EMAIL=CHANGE_ME_inbox_email
# Sender on a domain verified in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@pankajpramanik.com>

# --- Site ---
# NEXT_PUBLIC_* values are inlined at BUILD time. The image is built with
# https://pankajpramanik.com in .github/workflows/ci-cd.yml; keep this equal.
NEXT_PUBLIC_SITE_URL=https://pankajpramanik.com

# --- Content sync ---
# On every start the container imports prisma/content/snapshot.json only when
# it changed since the last import. Set to false to freeze production content.
# CONTENT_SYNC=true
